package solucion_1;

import java.util.ArrayList;
import java.util.Arrays;
import java.util.List;

public class solucion_1 {

    public static void main(String[] args) {
        
        List <String> inventariobase = new ArrayList<>();
        
        String [] frutasproovedor = {" pera ", " kiwi ", " naranja "," mandarina "};
        List <String> inventarioproovedor = Arrays.asList(frutasproovedor);
        
        inventariobase.add(" banano ");
        inventariobase.add(" Naranja ");
        inventariobase.add(" Manzana ");
        inventariobase.add(" fresa ");
        
        List<String> inventarioconsolidado = new ArrayList <> (inventariobase);
        inventarioconsolidado.addAll(inventarioproovedor);
        
        System.out.println("\n inventario base: ");
        inventariobase.forEach(System.out::println);
        System.out.println("\n inventario proovedor: ");
        inventarioproovedor.forEach(System.out::println);
        System.out.println("\n inventario consolidado: ");
        inventarioconsolidado.forEach(System.out::println);
        
    }
     
}
